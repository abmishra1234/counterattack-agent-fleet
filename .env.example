# Local API process. Keep the API bound to loopback until authentication is implemented.
COUNTERSTRIKE_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
METRICS_ENABLED=true
# Compose sets this to its private bridge subnet; keep the published port loopback-only.
API_TRUSTED_LOCAL_CLIENT_CIDRS=
LOG_LEVEL=INFO
LOCAL_DEV_IDENTITY=local-development
LOCAL_DEV_ROLE=operator
# Direct host processes can set this; Compose injects its private PostgreSQL URL.
DATABASE_URL=

# Input/output locations are server-side configuration; API requests cannot override them.
DATA_DIR=data
OUT_DIR=out
# Durable delivery intent enqueue is off by default; no channel sends are implemented yet.
OUTBOX_ENQUEUE_ENABLED=false
OUTBOX_CHANNEL=
OUTBOX_RECIPIENT_MAP_JSON=
# Public feeds remain disabled until source approval; enabling requires a database for checkpoints.
PUBLIC_FEEDS_ENABLED=false
PUBLIC_FEEDS_APPROVED=false
EPSS_ENABLED=false
EPSS_APPROVED=false
PUBLIC_FEED_SCHEDULER_ENABLED=false
PUBLIC_FEED_POLL_INTERVAL_MINUTES=15
PUBLIC_FEED_TIMEOUT_SECONDS=20
NVD_API_KEY=
WORKER_ID=
WORKER_LEASE_SECONDS=90
WORKER_POLL_SECONDS=2
FRONTEND_DIR=frontend
# Local Compose uses this development-only password unless overridden.
POSTGRES_PASSWORD=counterstrike-local-only
COMPOSE_SUBNET=172.16.240.0/24

# Offline model is the safe default. Use approved values only after LLM audit storage is ready.
LLM_PROVIDER=fake
# Legacy compatibility alias accepted by the CLI/settings loader; LLM_PROVIDER takes precedence.
# COUNTERSTRIKE_LLM=fake
LLM_LIVE_CALLS_ENABLED=false
LLM_DATA_BOUNDARY_APPROVED=false
LLM_ARTIFACT_RETENTION_APPROVED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RESPONSE_BYTES=2097152
LLM_EXTRACTION_ENABLED=true
LLM_SUMMARY_ENABLED=true

# Live requests remain off until provider/data-boundary and retention decisions are approved.
LLM_AUDIT_CONTENT_CAPTURE=false
# Single-key compatibility setting; use URL-safe base64 of 32 random bytes.
# Keyring entries take precedence by version.
LLM_AUDIT_ENCRYPTION_KEY=
LLM_AUDIT_ENCRYPTION_KEY_VERSION=local-v1
# Optional JSON map of retained key versions to URL-safe base64 AES-256 keys.
# Use URL-safe base64 of 32 random bytes per version.
# Example shape: {"local-v1":"<base64-key>","local-v2":"<base64-key>"}
LLM_AUDIT_ENCRYPTION_KEYRING_JSON=
LLM_AUDIT_ARTIFACT_RETENTION_DAYS=

# Leave prices empty until the approved provider/deployment rates are configured.
# Empty prices mean cost is unknown, not zero.
LLM_INPUT_PRICE_USD_PER_1M=
LLM_OUTPUT_PRICE_USD_PER_1M=
LLM_PRICING_VERSION=environment-rates-v1
LLM_PRICING_EFFECTIVE_AT=2000-01-01T00:00:00Z
LLM_MAX_COST_PER_RUN_USD=
LLM_MAX_COST_PER_MONTH_USD=
